{
  "$defs": {
    "BasicCard": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Permanent lowercase kebab-case id. Never rename after release.",
          "examples": [
            "n2-physique-001"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$",
          "title": "Id",
          "type": "string"
        },
        "deck": {
          "description": "Chemin du thème en français, sans le niveau.",
          "examples": [
            "Physique",
            "Sécurité::Prévention"
          ],
          "minLength": 1,
          "title": "Deck",
          "type": "string"
        },
        "levels": {
          "items": {
            "enum": [
              "N2",
              "N3",
              "N4"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Levels",
          "type": "array"
        },
        "tags": {
          "description": "Extra Anki tags",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "draft",
          "description": "draft is omitted from release builds"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inbox source note id, e.g. c16-0007. Several cards may share one id.",
          "title": "Source Id"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/Review"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "basic",
          "default": "basic",
          "title": "Type",
          "type": "string"
        },
        "fr": {
          "$ref": "#/$defs/BasicContent"
        }
      },
      "required": [
        "id",
        "deck",
        "levels",
        "fr"
      ],
      "title": "BasicCard",
      "type": "object"
    },
    "BasicContent": {
      "additionalProperties": false,
      "properties": {
        "front": {
          "description": "Prompt",
          "minLength": 1,
          "title": "Front",
          "type": "string"
        },
        "back": {
          "description": "Answer",
          "minLength": 1,
          "title": "Back",
          "type": "string"
        }
      },
      "required": [
        "front",
        "back"
      ],
      "title": "BasicContent",
      "type": "object"
    },
    "Choice": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "description": "Choice text shown on the card",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "correct": {
          "default": false,
          "description": "Exactly one choice per language must be true",
          "title": "Correct",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "Choice",
      "type": "object"
    },
    "ClozeCard": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Permanent lowercase kebab-case id. Never rename after release.",
          "examples": [
            "n2-physique-001"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$",
          "title": "Id",
          "type": "string"
        },
        "deck": {
          "description": "Chemin du thème en français, sans le niveau.",
          "examples": [
            "Physique",
            "Sécurité::Prévention"
          ],
          "minLength": 1,
          "title": "Deck",
          "type": "string"
        },
        "levels": {
          "items": {
            "enum": [
              "N2",
              "N3",
              "N4"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Levels",
          "type": "array"
        },
        "tags": {
          "description": "Extra Anki tags",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "draft",
          "description": "draft is omitted from release builds"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inbox source note id, e.g. c16-0007. Several cards may share one id.",
          "title": "Source Id"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/Review"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "cloze",
          "default": "cloze",
          "title": "Type",
          "type": "string"
        },
        "fr": {
          "$ref": "#/$defs/ClozeContent"
        }
      },
      "required": [
        "id",
        "deck",
        "levels",
        "fr"
      ],
      "title": "ClozeCard",
      "type": "object"
    },
    "ClozeContent": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "description": "Text containing at least one {{c1::...}} deletion",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "extra": {
          "default": "",
          "description": "Optional extra shown on the back",
          "title": "Extra",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ClozeContent",
      "type": "object"
    },
    "FactCheck": {
      "enum": [
        "pass",
        "fail",
        "unsure"
      ],
      "title": "FactCheck",
      "type": "string"
    },
    "McqCard": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Permanent lowercase kebab-case id. Never rename after release.",
          "examples": [
            "n2-physique-001"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$",
          "title": "Id",
          "type": "string"
        },
        "deck": {
          "description": "Chemin du thème en français, sans le niveau.",
          "examples": [
            "Physique",
            "Sécurité::Prévention"
          ],
          "minLength": 1,
          "title": "Deck",
          "type": "string"
        },
        "levels": {
          "items": {
            "enum": [
              "N2",
              "N3",
              "N4"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Levels",
          "type": "array"
        },
        "tags": {
          "description": "Extra Anki tags",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "draft",
          "description": "draft is omitted from release builds"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inbox source note id, e.g. c16-0007. Several cards may share one id.",
          "title": "Source Id"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/Review"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "mcq",
          "default": "mcq",
          "title": "Type",
          "type": "string"
        },
        "fr": {
          "$ref": "#/$defs/McqContent"
        }
      },
      "required": [
        "id",
        "deck",
        "levels",
        "fr"
      ],
      "title": "McqCard",
      "type": "object"
    },
    "McqContent": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "description": "Question stem; Markdown allowed",
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "maxItems": 10,
          "minItems": 2,
          "title": "Choices",
          "type": "array"
        },
        "explanation": {
          "description": "Why the answer is correct. Complementary fact, not a restatement of the keyed choice. Never a letter.",
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "question",
        "choices",
        "explanation"
      ],
      "title": "McqContent",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "fact_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sources": {
          "description": "Références vérifiables des documents sources.",
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "title": "Review",
      "type": "object"
    },
    "Status": {
      "enum": [
        "draft",
        "reviewed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cards": {
      "description": "Cards in this chapter",
      "items": {
        "discriminator": {
          "mapping": {
            "basic": "#/$defs/BasicCard",
            "cloze": "#/$defs/ClozeCard",
            "mcq": "#/$defs/McqCard"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/McqCard"
          },
          {
            "$ref": "#/$defs/BasicCard"
          },
          {
            "$ref": "#/$defs/ClozeCard"
          }
        ]
      },
      "title": "Cards",
      "type": "array"
    }
  },
  "title": "Plongée card file",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diving-theory/cards.schema.json",
  "description": "Un chapitre de cartes françaises pour les niveaux N2, N3 et N4. See CONTENT_GUIDELINES.md."
}
